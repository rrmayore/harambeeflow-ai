rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom user profiles collection
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Organizations collection
    match /organizations/{organizationId} {
      allow read: if true;
      allow write: if true;
      
      match /members/{memberId} {
        allow read: if true;
        allow write: if true;
      }
      match /roles/{roleId} {
        allow read: if true;
        allow write: if true;
      }
      match /auditLogs/{logId} {
        allow read: if true;
        allow write: if true;
      }
      match /activity/{activityId} {
        allow read: if true;
        allow write: if true;
      }
      match /notifications/{notifId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Payment accounts collection
    match /paymentAccounts/{accountId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Fundraisers collection
    match /fundraisers/{fundraiserId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Donations collection
    match /donations/{donationId} {
      allow read: if true;
      allow write: if true;
    }

    // Contributions collection
    match /contributions/{contributionId} {
      allow read: if true;
      allow write: if true;
    }
    
    // WhatsApp simulated group history messages
    match /whatsappMessages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // WhatsApp confirmations
    match /whatsappConfirmations/{confirmationId} {
      allow read: if true;
      allow write: if true;
    }

    // Donors collection
    match /donors/{phoneNumber} {
      allow read: if true;
      allow write: if true;
    }

    // Rate limit logs
    match /rate_limit_logs/{logId} {
      allow read, write: if true;
    }

    // Financial ledger
    match /financial_ledger/{ledgerId} {
      allow read: if true;
      allow write: if true;
    }

    // Mpesa pending payments
    match /mpesa_pending_payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    // Mpesa events
    match /mpesa_events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Idempotency keys
    match /idempotency_keys/{keyId} {
      allow read, write: if true;
    }

    // Dead letter queue
    match /dead_letter_queue/{queueId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity logs
    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Pledges collection
    match /pledges/{pledgeId} {
      allow read: if true;
      allow write: if true;
    }

    // Campaign lifecycle center collections
    match /campaignTasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }
    match /campaignTimeline/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /campaignAssets/{assetId} {
      allow read: if true;
      allow write: if true;
    }
    match /campaignCalendar/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /campaignArchive/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Analytics collections
    match /analyticsEvents/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /analyticsStats/{statsId} {
      allow read: if true;
      allow write: if true;
    }

    // Autopilot AI & Event Bus collections
    match /eventBus/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /eventQueue/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /processedEvents/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /automationExecutions/{executionId} {
      allow read: if true;
      allow write: if true;
    }

    match /systemLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /recognitions/{recognitionId} {
      allow read: if true;
      allow write: if true;
    }

    match /campaignSnapshots/{snapshotId} {
      allow read: if true;
      allow write: if true;
    }

    // Communications Automation Center
    match /messageTemplates/{templateId} {
      allow read: if true;
      allow write: if true;
    }

    match /automationFlows/{flowId} {
      allow read: if true;
      allow write: if true;
    }

    match /deliveryLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if true;
    }

    // Supporter Relationship Center
    match /supporterProfiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    match /communicationHistory/{historyId} {
      allow read: if true;
      allow write: if true;
    }

    // Document Vault
    match /documents/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    match /auditDocuments/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback catch-all for any other top-level collection or nested paths in development/demo
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
